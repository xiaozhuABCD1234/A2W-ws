# ============================================================
#  point_lio 运行时产物
#  ROOT_DIR = src/point_lio_ros2/
#  程序每次启动会清零覆写 Log/*.txt;PCD/ 在 pcd_save_en:=true 时生成
#  注意: PCD/ 目录本身不能忽略 —— 上游用 PCD/temp.txt 占位
#        因为 PCL 的 savePCDFileBinary 不会自建目录,少了它会存盘失败
# ============================================================
src/point_lio_ros2/Log/pos_log.txt
src/point_lio_ros2/Log/mat_out.txt
src/point_lio_ros2/Log/imu_pbp.txt
*.pcd

# ============================================================
#  上游演示资源
#  point_lio_ros2/image/ 是 246MB 的 demo GIF/PNG,不纳入版本库
# ============================================================
src/point_lio_ros2/image/

# ============================================================
#  编辑器 / IDE
# ============================================================
.vscode/
.idea/
*.swp
*~
compile_commands.json

