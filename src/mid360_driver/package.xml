<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mid360_driver</name>
  <version>1.0.0</version>
  <description>an implementation of the Mid-360 driver</description>
  <maintainer email="1709185482@qq.com">Yingjie Huang</maintainer>
  <license>MIT</license>
  <author email="1709185482@qq.com">Yingjie Huang</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- LOCAL PATCH M1:上游依赖 standalone asio;本机无 libasio-dev(且无 sudo),
       改用系统 Boost.Asio(见 src/asio_compat.hpp)。Boost 1.69+ 的 system 为 header-only,无需额外链接。 -->
  <depend>boost</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
