<?xml version="1.0"?>
<?xml-model href="http://www.ros.org/schema/package_format3.xsd" schemata="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>relocalization</name>
  <version>0.1.0</version>
  <description>Prior map relocalization with a voxel pyramid, 4-DOF search and GICP verification</description>
  <maintainer email="xiaozhuABCD1234@163.com">xiaozhu</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <export>
