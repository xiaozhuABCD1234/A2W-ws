Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
    CurrentViewClass: rviz_default_plugins/Orbit
    Views:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit
        Distance: 10
        Focal Point:
          X: 0
          Y: 0
          Z: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 164
      Line Style: Lines

    # 后端优化后的全局地图(map 系,回环纠偏后重发)
    - Class: rviz_default_plugins/PointCloud2
      Name: backend_map
      Enabled: true
      Topic:
        Value: /backend/map_points
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 0; 200; 255

    # 后端优化后的轨迹(map 系)
    - Class: rviz_default_plugins/Path
      Name: backend_path
      Enabled: true
      Topic:
        Value: /backend/path
      Color: 80; 255; 120
      Buffer Length: 1

    # 回环边 + 关键帧位置
    - Class: rviz_default_plugins/MarkerArray
      Name: backend_loops
      Enabled: true
      Topic:
        Value: /backend/loop_markers

    - Class: rviz_default_plugins/Map
      Name: OccupancyMap2D
      Enabled: true
      Topic:
        Value: /occupancy_map_2d/map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map

    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Enabled: true
      Topic:
        Value: /costmap_2d/grid
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.6
      Color Scheme: costmap

    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF_local
      Enabled: true
      Topic:
        Value: /esdf/local/points
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 4
      Color Transformer: Intensity
      Color: 255; 255; 255
      Channel Name: intensity
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 3
      Invert Rainbow: false
      Use rainbow: true
      Autocompute Value Bounds: true
      Position Transformer: XYZ
      Use Fixed Frame: true

    - Class: rviz_default_plugins/PointCloud2
      Name: ESDF_global
      Enabled: false
      Topic:
        Value: /esdf/global/points
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 3
      Color Transformer: Intensity
      Color: 255; 255; 255
      Channel Name: intensity
      Autocompute Intensity Bounds: false
      Min Intensity: 0
      Max Intensity: 10
      Invert Rainbow: false
      Use rainbow: true
      Autocompute Value Bounds: true
      Position Transformer: XYZ
      Use Fixed Frame: true

    # 注意:这里**故意不再放** /cloud_registered(frame=camera_init)与 /path。
    # Fixed Frame 是 map 时,这类 camera_init 系的显示每个都要 map->camera_init,
    # 而 point_lio 先发点云、后发 odom,点云到达那一刻 TF 还没追上,rviz 状态栏就
    # 一直挂着 "Could not transform from [camera_init] to [map]"(实测)。
    # map 系对应的东西已经有 /backend/map_points + /backend/path;
    # 真要对照原始点云,把下面这段取消注释即可(它是 map 系,不需要额外 TF):
    #   - Class: rviz_default_plugins/PointCloud2
    #     Name: cloud_registered
    #     Enabled: true
    #     Topic: {Value: /cloud_registered}
    # 或者直接把 Fixed Frame 改成 camera_init 再用旧配置 octomap.rviz。

    # octomap(map 系,后端启用时)
    - Class: rviz_default_plugins/PointCloud2
      Name: Ground
      Enabled: true
      Topic:
        Value: /ground_segmentation/ground
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 6
      Color Transformer: FlatColor
      Color: 60; 230; 120

    - Class: rviz_default_plugins/PointCloud2
      Name: Nonground
      Enabled: true
      Topic:
        Value: /ground_segmentation/nonground
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 6
      Color Transformer: FlatColor
      Color: 40; 140; 255

    - Class: octomap_rviz_plugins/OccupancyGrid
      Name: OctomapGrid
      Enabled: false
      Topic:
        Value: /octomap_binary
      Voxel Rendering: Occupied Voxels
      Voxel Coloring: Z-Axis
      Voxel Alpha: 0.9
      Max. Octree Depth: 16

    - Class: rviz_default_plugins/PointCloud2
      Name: Octomap_fallback_points
      Enabled: true
      Topic:
        Value: /octomap_point_cloud_centers
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 140; 0

    # 坐标系:map -> camera_init(后端) -> body(point_lio)
    - Class: rviz_default_plugins/Path
      Name: PlannerPath
      Enabled: true
      Topic:
        Value: /planner/path
      Line Style: Billboards
      Line Width: 0.08
      Color: 255; 200; 60
      Alpha: 1
      Buffer Length: 1

    - Class: rviz_default_plugins/Path
      Name: ControllerPath
      Enabled: true
      Topic:
        Value: /controller/smoothed_path
      Line Style: Lines
      Line Width: 0.04
      Color: 120; 255; 170
      Alpha: 0.9
      Buffer Length: 1

    - Class: rviz_default_plugins/MarkerArray
      Name: ControllerTrajectory
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /controller/trajectory
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable

    - Class: rviz_default_plugins/Polygon
      Name: RobotFootprint
      Enabled: true
      Topic:
        Value: /robot_footprint
      Color: 0; 255; 255
      Alpha: 0.6

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 0.8

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1

  Global Options:
    Fixed Frame: map
    Background Color: 20; 20; 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Window Geometry:
    Width: 1280
    Height: 800
