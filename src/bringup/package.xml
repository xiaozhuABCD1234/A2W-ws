<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>
    Mid-360 + Point-LIO 的周边集成(Mid-360 驱动 / Point-LIO 均为本仓库内的本地上游包)。
    一键启动驱动、Point-LIO、后端位姿图、重定位、地面分割、2D 占据图与 rviz。
    本包只放 launch / rviz 配置,不含编译产物。
  </description>
  <maintainer email="xiaozhuABCD1234@163.com">xiaozhu</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <exec_depend>point_lio</exec_depend>
  <exec_depend>point_lio_backend</exec_depend>
  <exec_depend>relocalization</exec_depend>
  <exec_depend>ground_segmentation</exec_depend>
  <exec_depend>occupancy_map_2d</exec_depend>
  <exec_depend>mid360_driver</exec_depend>
  <exec_depend>pcl_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
