Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
    CurrentViewClass: rviz_default_plugins/Orbit
    Views:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit
        Distance: 10
        Focal Point:
          X: 0
          Y: 0
          Z: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 164
      Line Style: Lines

    # 后端优化后的全局地图(map 系,回环纠偏后重发)
    - Class: rviz_default_plugins/PointCloud2
      Name: backend_map
      Enabled: true
      Topic:
        Value: /backend/map_points
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 0; 200; 255

    # 后端优化后的轨迹(map 系)
    - Class: rviz_default_plugins/Path
      Name: backend_path
      Enabled: true
      Topic:
        Value: /backend/path
      Color: 80; 255; 120
      Buffer Length: 1

    # 回环边 + 关键帧位置
    - Class: rviz_default_plugins/MarkerArray
      Name: backend_loops
      Enabled: true
      Topic:
        Value: /backend/loop_markers

    # 注意:这里**故意不再放** /cloud_registered(frame=camera_init)与 /path。
    # Fixed Frame 是 map 时,这类 camera_init 系的显示每个都要 map->camera_init,
    # 而 point_lio 先发点云、后发 odom,点云到达那一刻 TF 还没追上,rviz 状态栏就
    # 一直挂着 "Could not transform from [camera_init] to [map]"(实测)。
    # map 系对应的东西已经有 /backend/map_points + /backend/path;
    # 真要对照原始点云,把下面这段取消注释即可(它是 map 系,不需要额外 TF):
    #   - Class: rviz_default_plugins/PointCloud2
    #     Name: cloud_registered
    #     Enabled: true
    #     Topic: {Value: /cloud_registered}
    # 或者直接把 Fixed Frame 改成 camera_init 再用旧配置 octomap_mid360.rviz。

    # octomap(map 系,后端启用时)
    - Class: octomap_rviz_plugins/OccupancyGrid
      Name: OctomapGrid
      Enabled: false
      Topic:
        Value: /octomap_binary
      Voxel Rendering: Occupied Voxels
      Voxel Coloring: Z-Axis
      Voxel Alpha: 0.9
      Max. Octree Depth: 16

    - Class: rviz_default_plugins/PointCloud2
      Name: Octomap_fallback_points
      Enabled: true
      Topic:
        Value: /octomap_point_cloud_centers
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 140; 0

    # 坐标系:map -> camera_init(后端) -> body(point_lio)
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1

  Global Options:
    Fixed Frame: map
    Background Color: 20; 20; 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Window Geometry:
    Width: 1280
    Height: 800
