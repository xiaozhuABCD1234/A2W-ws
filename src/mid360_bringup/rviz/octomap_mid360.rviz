Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
    CurrentViewClass: rviz_default_plugins/Orbit
    Views:
      - Class: rviz_default_plugins/Orbit
        Name: Orbit
        Distance: 10
        Focal Point:
          X: 0
          Y: 0
          Z: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 164
      Line Style: Lines

    # LIO 当前帧点云(世界系,已配准)
    - Class: rviz_default_plugins/PointCloud2
      Name: cloud_registered
      Enabled: true
      Topic:
        Value: /cloud_registered
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 80; 220; 80

    # LIO 全局累积地图(密集,点多了再开)
    - Class: rviz_default_plugins/PointCloud2
      Name: Laser_map
      Enabled: false
      Topic:
        Value: /Laser_map
      Style: Points
      Size (Pixels): 1
      Color Transformer: FlatColor
      Color: 200; 200; 200

    # 轨迹
    - Class: rviz_default_plugins/Path
      Name: path
      Enabled: true
      Topic:
        Value: /path
      Color: 255; 80; 80
      Buffer Length: 1

    # octomap 三维占据栅格
    - Class: octomap_rviz_plugins/Octomap
      Name: Octomap
      Enabled: true
      Topic:
        Value: /octomap_full
      Color Scheme: 1
      Alpha: 0.8

    # 坐标系(只有 camera_init ↔ body 两条)
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 1

  Global Options:
    Fixed Frame: camera_init
    Background Color: 20; 20; 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Window Geometry:
    Width: 1280
    Height: 800