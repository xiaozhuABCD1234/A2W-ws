<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="warehouse_agv">

  <xacro:arg name="lidar_x" default="0.10"/>
  <xacro:arg name="lidar_y" default="0.0"/>
  <xacro:arg name="lidar_z" default="0.24"/>
  <xacro:arg name="lidar_roll" default="0.0"/>
  <xacro:arg name="lidar_pitch" default="0.0"/>
  <xacro:arg name="lidar_yaw" default="0.0"/>

  <!--
    Source of truth for the warehouse AGV robot description.

    Frame convention (REP-103): +X forward, +Y left, +Z up.
    base_footprint is the drive-axle ground projection. base_link is at axle height.
    Dimensions and estimated mass properties are documented in
    docs/urdf-design-ledger.md.
  -->

  <!-- Shared visual materials. -->
  <material name="agv_red">
    <color rgba="0.72 0.05 0.05 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>

  <!-- Frame-only ground projection. -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="-0.08 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Main chassis. The link frame lies at the chassis centre and axle height. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.35 0.20"/>
      </geometry>
      <material name="agv_red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.35 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia
        ixx="0.135416667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.241666667"
        iyz="0.0"
        izz="0.310416667"/>
    </inertial>
  </link>

  <!-- Left drive wheel. Positive rotation about +Y drives the wheel forward. -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.000866667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001600000"
        iyz="0.0"
        izz="0.000866667"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0.08 0.195 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right drive wheel. Positive rotation about +Y drives the wheel forward. -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.000866667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.001600000"
        iyz="0.0"
        izz="0.000866667"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0.08 -0.195 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear support is intentionally simplified as a low-friction ball caster. -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.000064"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000064"
        iyz="0.0"
        izz="0.000064"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.18 0 -0.04" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR body and scan frame. -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.000151667"
        ixy="0.0"
        ixz="0.0"
        iyy="0.000151667"
        iyz="0.0"
        izz="0.000250000"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)" rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
  </joint>

  <!-- Gazebo contact tuning. The caster must slide freely during later turns. -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <gazebo reference="base_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic>
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="mid360_lidar" type="lidar">
      <always_on>false</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/mid360/unused</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range><min>0.1</min><max>0.2</max></range>
      </ray>
    </sensor>
  </gazebo>

  <!-- Gazebo Harmonic native differential-drive controller. -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- Calibrated effective track width; wheel centres are 0.39 m apart. -->
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.08</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>

      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>
  </gazebo>

</robot>
